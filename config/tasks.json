{
  "version": 1,
  "mining": {
    "since": "2022-01-01",
    "scan": 400,
    "max_files": 6,
    "max_lines": 400,
    "min_lines": 2,
    "min_problem_chars": 200,
    "max_problem_chars": 8000,
    "exclude_subject": "(?i)\\b(upgrade|bump|refactor|cleanup|clean up|migrate|reformat|typo|lint)\\b",
    "symbols_per_commit": 1,
    "holdout_fraction": 0.2,
    "split_seed": 0
  },
  "tasks": {
    "localization": {
      "enabled": true,
      "description": "Issue/PR text -> production files and line hunks changed by the fix commit. The original bench/ task, generalised to any configured repository and language.",
      "miner": "git_issue",
      "scorer": "localization",
      "query_source": "issue",
      "allow_default_query": true,
      "metrics": [
        "recall@1",
        "recall@3",
        "recall@5",
        "recall@10",
        "mrr@10",
        "hunk@5"
      ]
    },
    "symbol_definition": {
      "enabled": true,
      "description": "Given a symbol changed by a fix, return its definition file and line. Ground truth is the declaration site in the base tree.",
      "miner": "structural",
      "scorer": "site",
      "query_source": "structural",
      "query_template": "Where is `{symbol}` defined?",
      "metrics": [
        "hit@1",
        "hit@3",
        "hit@5",
        "mrr@10",
        "site_recall@10",
        "site_precision@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 1,
      "max_gold_files": 5
    },
    "symbol_definitions": {
      "enabled": true,
      "description": "Given a name with multiple declarations, list every definition. This exercises symbol identity and completeness instead of filtering ambiguous names out of the benchmark.",
      "miner": "structural",
      "scorer": "sites",
      "query_source": "structural",
      "query_template": "List every definition of `{symbol}`.",
      "metrics": [
        "hit@1",
        "hit@3",
        "hit@5",
        "hit@10",
        "mrr@10",
        "site_recall@10",
        "site_precision@10",
        "all_sites@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 2,
      "max_gold_files": 20,
      "allow_ambiguous": true,
      "scan_all_symbols": true
    },
    "callers": {
      "enabled": true,
      "description": "Given a symbol changed by a fix, return the files that call it. Gold is derived from textual call sites at the base commit.",
      "miner": "structural",
      "scorer": "set",
      "query_source": "structural",
      "query_template": "Find all callers of `{symbol}`.",
      "metrics": [
        "recall@5",
        "recall@10",
        "all@10",
        "hit@10",
        "precision@10",
        "mrr@10",
        "site_recall@10",
        "site_precision@10",
        "edge_recall@10",
        "edge_precision@10",
        "edge_f1@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 1,
      "max_gold_files": 30
    },
    "callees": {
      "enabled": true,
      "description": "Given a symbol changed by a fix, return the files that define the symbols it calls.",
      "miner": "structural",
      "scorer": "set",
      "query_source": "structural",
      "query_template": "Find all functions called by `{symbol}`.",
      "metrics": [
        "recall@5",
        "recall@10",
        "all@10",
        "hit@10",
        "precision@10",
        "mrr@10",
        "site_recall@10",
        "site_precision@10",
        "edge_recall@10",
        "edge_precision@10",
        "edge_f1@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 1,
      "max_gold_files": 30
    },
    "impact": {
      "enabled": true,
      "description": "Given a symbol changed by a fix, return the files affected by changing it (transitive callers up to --impact-depth).",
      "miner": "structural",
      "scorer": "set",
      "query_source": "structural",
      "query_template": "What code is affected if `{symbol}` changes?",
      "metrics": [
        "recall@5",
        "recall@10",
        "all@10",
        "hit@10",
        "mrr@10",
        "site_recall@10",
        "site_precision@10"
      ],
      "symbols_per_commit": 1,
      "impact_depth": 2,
      "min_gold_files": 1,
      "max_gold_files": 40
    },
    "dependents": {
      "enabled": true,
      "description": "Given a file changed by a fix, return the files that import it. Gold is derived from the base tree's import graph.",
      "miner": "structural",
      "scorer": "set",
      "query_source": "structural",
      "query_template": "Which files import `{path}`?",
      "metrics": [
        "recall@5",
        "recall@10",
        "all@10",
        "hit@10",
        "precision@10",
        "mrr@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 1,
      "max_gold_files": 40
    },
    "references": {
      "enabled": true,
      "description": "Given a symbol, return every non-declaration reference to it: calls, field/type uses, annotations, and other identifier occurrences. This is broader than callers.",
      "miner": "structural",
      "scorer": "set",
      "query_source": "structural",
      "query_template": "Find every reference to `{symbol}`.",
      "metrics": [
        "recall@5",
        "recall@10",
        "all@10",
        "hit@10",
        "precision@10",
        "mrr@10",
        "site_recall@10",
        "site_precision@10",
        "edge_recall@10",
        "edge_precision@10",
        "edge_f1@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 1,
      "max_gold_files": 40
    },
    "implementations": {
      "enabled": true,
      "description": "Given a type, return every type that extends or implements it (direct and transitive), derived from class headers.",
      "miner": "structural",
      "scorer": "set",
      "query_source": "structural",
      "query_template": "Find all types that extend or implement `{symbol}`.",
      "metrics": [
        "recall@5",
        "recall@10",
        "all@10",
        "hit@10",
        "precision@10",
        "mrr@10",
        "site_recall@10",
        "site_precision@10",
        "edge_recall@10",
        "edge_precision@10",
        "edge_f1@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 1,
      "max_gold_files": 40,
      "scan_all_symbols": true,
      "allow_ambiguous": true
    },
    "overrides": {
      "enabled": true,
      "description": "Given a method, return methods in subtypes that override it. This exercises type hierarchy plus method identity.",
      "miner": "structural",
      "scorer": "set",
      "query_source": "structural",
      "query_template": "Find all methods that override `{symbol}`.",
      "metrics": [
        "recall@5",
        "recall@10",
        "all@10",
        "hit@10",
        "precision@10",
        "mrr@10",
        "site_recall@10",
        "site_precision@10",
        "edge_recall@10",
        "edge_precision@10",
        "edge_f1@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 1,
      "max_gold_files": 40,
      "scan_all_symbols": true,
      "allow_ambiguous": true
    },
    "no_callers": {
      "enabled": true,
      "description": "Negative control: the symbol has no callers. A successful tool must abstain instead of returning plausible files.",
      "miner": "structural",
      "scorer": "absence",
      "query_source": "structural",
      "query_template": "Find all callers of `{symbol}`.",
      "metrics": [
        "abstain@10",
        "clean@10",
        "false_positives@10"
      ],
      "symbols_per_commit": 1,
      "min_gold_files": 0,
      "max_gold_files": 0,
      "allow_empty_gold": true,
      "scan_all_symbols": true
    }
  }
}
